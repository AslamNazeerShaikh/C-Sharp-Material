{
  "$schema": "https://opencode.ai/config.json",
  "version": "1.0.0",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "small_model": "opencode/muse-spark-1.3-contributor-free",
  "provider": {
    "opencode": {
      "models": {
        "muse-spark-1.3-contributor-free": {
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  },
  "project": {
    "name": "CSharpCodePractice",
    "description": "C# logic-building practice: console demos (MainConsoleApp) + string/array/algorithm exercises (ClassCodeLibrary, one folder per topic with code + notes). .NET 10, single .slnx solution.",
    "type": "dotnet"
  },
  "instructions": ["AGENTS.md", "README.md"],
  "agents": {
    "default": "csharp-practice-assistant",
    "list": [
      "csharp-practice-assistant",
      "code-reviewer",
      "test-writer",
      "documentation-writer"
    ]
  },
  "skills": {
    "enabled": [
      "csharp-development",
      "testing-strategy"
    ]
  },
  "commands": {
    "custom": [
      "dotnet-build",
      "dotnet-test",
      "dotnet-run",
      "dotnet-clean",
      "dotnet-publish",
      "dotnet-lint",
      "build",
      "test",
      "lint",
      "format",
      "run",
      "clean"
    ]
  },
  "permission": {
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "chmod 777 *": "deny"
    }
  },
  "lsp": true,
  "plugin": [],
  "mcp": {
    "ui-skills": {
      "type": "remote",
      "url": "https://www.ui-skills.com/mcp",
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "whiteboard": {
      "type": "local",
      "command": ["sh", "-c", "exec \"$HOME/.local/bin/whiteboard\" mcp"],
      "enabled": true
    }
  }
}

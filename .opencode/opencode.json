{
  "$schema": "https://opencode.ai/config.json",
  "version": "1.0.0",
  "model": "opencode/beam-free",
  "small_model": "opencode/beam-free",
  "provider": {
    "opencode": {
      "models": {
        "beam-free": {
          "options": {
            "reasoningEffort": "max"
          }
        }
      }
    }
  },
  "project": {
    "name": "CSharpCodePractice",
    "description": "C# logic-building practice: console demos (MainConsoleApp) + string/array/algorithm exercises (ClassCodeLibrary, one folder per topic with code + notes). .NET 10, single .slnx solution.",
    "type": "dotnet"
  },
  "instructions": ["AGENTS.md", "README.md"],
  "agents": {
    "default": "csharp-practice-assistant",
    "list": [
      "csharp-practice-assistant",
      "code-reviewer",
      "test-writer",
      "documentation-writer"
    ]
  },
  "skills": {
    "enabled": [
      "csharp-development",
      "testing-strategy"
    ]
  },
  "commands": {
    "custom": [
      "dotnet-build",
      "dotnet-test",
      "dotnet-run",
      "dotnet-clean",
      "dotnet-publish",
      "dotnet-lint",
      "build",
      "test",
      "lint",
      "format",
      "run",
      "clean"
    ]
  },
  "permission": {
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "chmod 777 *": "deny"
    }
  },
  "lsp": true,
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git#v7.0.2",
    "@dietrichgebert/ponytail@5.3.3"
  ],
  "experimental": {
    "todo": true
  },
  "mcp": {
    "servers": {
      "ui-skills": {
        "type": "remote",
        "url": "https://www.ui-skills.com/mcp"
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
        }
      }
    }
  }
}
